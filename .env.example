# Never commit real keys or webhook URLs. Configure these in Vercel Project Settings > Environment Variables.
# Discord: create a NEW webhook in the target Discord channel and paste URL privately in Vercel.
DISCORD_WEBHOOK_URL=
# Vercel Cron automatically sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Persistent deduplication; required before alerts can be delivered safely.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: enables signed Frontrun Pro webhook ingestion.
# Set the same random string when registering a Frontrun webhook.
FRONTRUN_WEBHOOK_SECRET=
